{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "clipforge.clip.v1",
  "title": "ClipSidecar",
  "type": "object",
  "required": [
    "schema",
    "clip_id",
    "source",
    "detection",
    "media",
    "review",
    "created_at"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "clipforge.clip.v1"
    },
    "clip_id": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["url_host", "channel", "session_id", "t_start_stream", "t_end_stream"],
      "properties": {
        "url_host": { "type": "string" },
        "channel": { "type": "string" },
        "session_id": { "type": "string" },
        "t_start_stream": { "type": "number", "minimum": 0 },
        "t_end_stream": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "detection": {
      "type": "object",
      "required": ["id", "fused_score", "top_signals"],
      "properties": {
        "id": { "type": "string" },
        "fused_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "top_signals": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "required": ["file", "duration_s", "width", "height", "codec", "vertical"],
      "properties": {
        "file": { "type": "string" },
        "duration_s": { "type": "number", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "codec": { "type": "string" },
        "vertical": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "title", "tags", "notes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unreviewed", "approved", "rejected"]
        },
        "title": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
